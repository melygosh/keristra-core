<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" id="definitions" name="definitions" namespace="http://camunda.org/schema/1.0/dmn">
  <decision id="decision" name="FOP monthly single tax and military levy 2025 (human reference)">
    <decisionTable id="decisionTable" hitPolicy="FIRST">
      <input id="input-1" label="fop.requestedGroup">
        <inputExpression id="input-1-exp" typeRef="integer" expressionLanguage="feel">
          <text>fop.requestedGroup</text>
        </inputExpression>
      </input>
      <input id="input-2" label="fop.vatPayer">
        <inputExpression id="input-2-exp" typeRef="boolean" expressionLanguage="feel">
          <text>fop.vatPayer</text>
        </inputExpression>
      </input>
      <output id="output-1" label="singleTax" name="singleTax" typeRef="number" />
      <output id="output-2" label="militaryLevy" name="militaryLevy" typeRef="number" />
      <rule id="rule-1">
        <inputEntry id="rule-1-input-1">
          <text>1</text>
        </inputEntry>
        <inputEntry id="rule-1-input-2">
          <text></text>
        </inputEntry>
        <outputEntry id="rule-1-output-1">
          <text>302.8</text>
        </outputEntry>
        <outputEntry id="rule-1-output-2">
          <text>800.0</text>
        </outputEntry>
      </rule>
      <rule id="rule-2">
        <inputEntry id="rule-2-input-1">
          <text>2</text>
        </inputEntry>
        <inputEntry id="rule-2-input-2">
          <text></text>
        </inputEntry>
        <outputEntry id="rule-2-output-1">
          <text>1600.0</text>
        </outputEntry>
        <outputEntry id="rule-2-output-2">
          <text>800.0</text>
        </outputEntry>
      </rule>
      <rule id="rule-3">
        <inputEntry id="rule-3-input-1">
          <text>3</text>
        </inputEntry>
        <inputEntry id="rule-3-input-2">
          <text>true</text>
        </inputEntry>
        <outputEntry id="rule-3-output-1">
          <text>decimal(fop.monthlyIncome * 0.03, 2)</text>
        </outputEntry>
        <outputEntry id="rule-3-output-2">
          <text>decimal(fop.monthlyIncome * 0.01, 2)</text>
        </outputEntry>
      </rule>
      <rule id="rule-4">
        <inputEntry id="rule-4-input-1">
          <text>3</text>
        </inputEntry>
        <inputEntry id="rule-4-input-2">
          <text></text>
        </inputEntry>
        <outputEntry id="rule-4-output-1">
          <text>decimal(fop.monthlyIncome * 0.05, 2)</text>
        </outputEntry>
        <outputEntry id="rule-4-output-2">
          <text>decimal(fop.monthlyIncome * 0.01, 2)</text>
        </outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
